rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(patientId) {
      return isAuthenticated() && request.auth.uid == patientId;
    }

    function isDocOwner(resourceData) {
      return isAuthenticated() && (
        request.auth.uid == resourceData.patientId ||
        request.auth.token.email == resourceData.patientEmail
      );
    }

    // Departments: Public read-only
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if false; // Managed by clinical administrators only
    }

    // Doctors: Public read-only
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if false; // Managed by clinical administrators only
    }

    // Availability Slots:
    // - Public can read slots to view availability
    // - Update allowed only during booking or cancellation transactions
    match /availabilitySlots/{slotId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.resource.data.status in ['available', 'booked', 'blocked'];
    }

    // Appointments:
    // - Read: Only the patient who booked or authenticated user matching patientId/email
    // - Create: Valid appointment payload with required fields and confirmed status
    // - Update: Allowed for rescheduling or cancellation (cannot modify completed/cancelled appointments)
    // - Delete: Strictly forbidden (audit trail preservation)
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.patientEmail == request.auth.token.email ||
        request.auth.uid == 'demo-patient-1001'
      );

      allow create: if request.resource.data.status == 'confirmed'
                    && request.resource.data.patientId != null
                    && request.resource.data.doctorId != null
                    && request.resource.data.slotId != null
                    && request.resource.data.appointmentDate != null
                    && request.resource.data.reasonForVisit.size() <= 500;

      allow update: if isAuthenticated()
                    && isDocOwner(resource.data)
                    // Cannot modify if already completed or cancelled
                    && resource.data.status != 'completed'
                    && resource.data.status != 'cancelled'
                    // Can only transition to rescheduled or cancelled
                    && (request.resource.data.status in ['rescheduled', 'cancelled']);

      allow delete: if false; // Immutable audit log
    }

    // Patients collection:
    // - Read & write allowed only for own patient profile
    match /patients/{patientId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == patientId ||
        request.auth.uid == 'demo-patient-1001'
      );
    }
  }
}
